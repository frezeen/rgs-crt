# Part of crt-dual — https://github.com/frezeen
# 99-crt-dual-hotplug.rules — CRT-DUAL: drm hotplug -> wake the reconciler.
# The handler is a MUTE POKE (drops /tmp/crt-dual/udev-poke — NOT the manual
# hotplug-trigger: reusing it self-perpetuated into a storm, 2026-08-23):
# since the reconciler refactor (ADR 002) src/display/display-reconcile.sh is
# the single applier — it consumes the poke, observes until X settles, and
# applies only what detect -> model says is missing. The pocker itself is
# src/layout/hotplug-layout.sh: it probes and applies nothing.
# KERNEL=="card*" matches cardN device events AND cardN-<CONNECTOR> connector
# events (that is how drm hotplug arrives). Deployed by install.sh/deploy.sh
# to /etc/udev/rules.d/.
SUBSYSTEM=="drm", KERNEL=="card*", ACTION=="change", RUN+="/userdata/system/crt-dual/src/layout/hotplug-layout.sh"
