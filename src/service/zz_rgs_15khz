#!/bin/bash
# zz_rgs_15khz — RGS boot service + update watch (step 8).
#
# Runs in the SAME S99userservices loop as rgs_config (enabled via stock
# batocera-services, called as `zz_rgs_15khz {start|stop}`). Order vs
# rgs_config is NOT guaranteed (it runs async via `start &`), so this
# service is order-INDEPENDENT: it observes (cmp) and re-deploys, never
# assumes.
#
# start duties: truncate OUR log files (explicit list — the logs dir is
# shared with stock logs, a glob would truncate stock files); log the
# rgs_config ordering evidence; run the update watch (adopt a re-verified
# RGS update, or on RED hold the 15kHz profile so launches run stock/LCD
# behavior and skip the re-injection onto an unverified system — the log
# invites the user to run the rgs_crt_check tool from the Batocera
# config menu); re-deploy ONLY the manifest-listed overlay
# files that drifted (install.sh is authoritative and rewrites the
# manifest every run); save the overlay IFF something was re-deployed;
# re-create the VNC symlinks (stateless per boot); wait for rgs_config to
# finish then re-apply the stock-launcher raster hunks (bounded, 2026-10-07
# race); recompute the amdgpu
# dc=0 modprobe pin (amdgpu-legacy duty, 2026-09-10 — the modprobe.d
# file must exist BEFORE the module binds, so the boot service writes
# it for the NEXT boot; install.sh calls the same one-shot); keep the
# Intel i915 480i patch on /boot (i915-patch duty: hook + module deployed
# there once by install.sh, self-healed at boot when drifted; the /boot
# hook itself swaps the module BEFORE udev at every boot — see the duty
# below and src/service/i915/boot-custom.sh). On non-Intel boots the duty
# removes BOTH pieces (ours only, foreign hook never touched): a GPU swap
# back to AMD leaves no residue and verify.sh stays clean.
# Exit 0 always (a boot service must not block boot; drift goes LOUDLY
# into the log, and verify.sh flags it).
#
# Measured update model (2026-09-07): an RGS update lands ONLY under
# /userdata — rgs.version changes LIVE, the new generators wait in
# rgs/fix/ and reach the system at the NEXT boot (rgs_config copies
# fix/ -> /usr,/etc). So fix/ IS the future system state, and the watch
# verifies the layer against it.
#
# Env seams (tests): RGS15_PKG/LOG, RGS15_RGS_VERSION_FILE/
# BATOCERA_VERSION_FILE/RGS_CONFIG/FIX_DIR/SITE/SHADOW/CONF,
# RGS15_RGS_DIR (the +rgs surface: gamelist-ensure),
# RGS15_MODPROBE_CONF/RGS15_UNAME_R/RGS15_PCI_SYS (amdgpu-legacy),
# RGS15_DMESG_SRC + RGS15_BOOT_HOOK/RGS15_BOOT_MOD/RGS15_I915_REPO/
# RGS15_I915_ALLOW_FETCH (i915-patch),
# RGS15_FEED_VERSION_URL/RGS15_FETCH_BIN/RGS15_FETCH_TIMEOUT/
# RGS15_FEED_ALLOW_NET (feed-check), RGS15_SRC/RGS15_UPDATE_GET
# (tool-update: project folder / get.sh path overrides),
# RGS15_RES_TARGET/RGS15_RES_BAK (resolution-patch),
# RGS15_RGS_CONFIG_PROC/WAIT/GRACE/POLL (the rgs_config order wait).

set -uo pipefail

PKG="${RGS15_PKG:-/userdata/system/crt-dual}"
LOG="${RGS15_LOG:-/userdata/system/logs/rgs-15khz.log}"
LOGS_DIR="$(dirname "$LOG")"
# Explicit truncation list — OUR files only (service log + engine runtime
# log the game path appends to; stock display.log/es_launch_* NEVER touched).
TRUNCATE_LIST="rgs-15khz.log selector-core.log selector.log display-reconcile.log display-detect.log"
RGS_FIX="/userdata/system/rgs/fix"
# +rgs surface (gamelist + tile) is a PATH SEAM: install/uninstall run in
# the seam suite, and a hardcoded live path here rewrote the LIVE tile on
# every suite run (2026-09-23 leak audit). Default = live.
RGS_DIR="${RGS15_RGS_DIR:-/userdata/roms/rgs}"
MANIFEST="$PKG/overlay-manifest"
RGS_VERSION_SRC="${RGS15_RGS_VERSION_FILE:-/userdata/system/rgs.version}"
BATOCERA_VERSION_SRC="${RGS15_BATOCERA_VERSION_FILE:-/usr/share/batocera/batocera.version}"
RGS_CONFIG="${RGS15_RGS_CONFIG:-/userdata/system/services/rgs_config}"
GUARD_SITE="${RGS15_SITE:-$(python3 -c 'import site; print(site.getsitepackages()[0])' 2>/dev/null)}"
GUARD_SHADOW="${RGS15_SHADOW:-/tmp/rgs-15khz-boot-shadow}"
GUARD_CONF="${RGS15_CONF:-/userdata/system/batocera.conf}"
GUARD_FIX="${RGS15_FIX_DIR:-$RGS_FIX}"
MODPROBE_CONF="${RGS15_MODPROBE_CONF:-/etc/modprobe.d/rgs-15khz-amdgpu-legacy.conf}"

log() {
	echo "zz_rgs_15khz [$(date +%FT%T)]: $*" >>"$LOG" 2>/dev/null || true
}

# Effective batocera.conf value: stock batocera-settings-set APPENDS (the
# LAST occurrence wins — same semantics the selector merge uses); reading
# the first line returns a stale value after any in-ES edit.
conf_get() { grep -E "^$1[[:space:]]*=" "$GUARD_CONF" 2>/dev/null | tail -1 | cut -d= -f2- | tr -d '[:space:]"'; }

# manifest line -> package source path. Manifest stores installed overlay
# DSTs; the source is derived: DST under /etc|/usr/lib must equal the
# package file with the same identifying basename, mapped here explicitly
# (no guessing — an unmapped entry is a loud error, never a skipped file).
manifest_src() {
	case "$1" in
	*/sitecustomize.py) printf '%s' "$PKG/src/selector/sitecustomize.py" ;;
	*/S15crt-dual-gen) printf '%s' "$PKG/src/service/crt-gen-initd.sh" ;;
	*/S30z-crt-dual-measure) printf '%s' "$PKG/src/service/dotclock-boot-initd.sh" ;;
	*/99-crt-dual-hotplug.rules) printf '%s' "$PKG/src/udev/99-crt-dual-hotplug.rules" ;;
	*) return 1 ;;
	esac
	return 0
}

# ── profile hold/restore: the RED-state off switch ───────────────────────
# RED = the layer cannot be certified on the new system. Holding every
# crt-targeting profile (generic: spec [display] target = crt, never a
# profile name) leaves the selector with no CRT candidates → launches
# run the stock profile / stock default = LCD-style behavior, tube stays
# on the gated boot mode. Fully reversible (restore renames back).
guard_profile_hold() {
	local _spec
	for _spec in "$PKG"/profiles/*/spec.conf; do
		[ -f "$_spec" ] || continue
		grep -q '^target = crt' "$_spec" 2>/dev/null || continue
		mv "$_spec" "$_spec.hold" \
			&& log "guard profile held: $(basename "$(dirname "$_spec")")" \
			|| log "guard WARN: could not hold $(dirname "$_spec")"
	done
}

guard_profile_restore() {
	local _spec
	for _spec in "$PKG"/profiles/*/spec.conf.hold; do
		[ -f "$_spec" ] || return 0
		mv "$_spec" "${_spec%.hold}" \
			&& log "guard profile restored: $(basename "$(dirname "$_spec")")" \
			|| log "guard WARN: could not restore $(dirname "$_spec")"
	done
}

# ── guard_run: the update watch, ONE logic copy. ─────────────────────────
# Hold => rc 1 (the boot caller skips re-deploy + VNC).
# Versions match => rc 0, zero cost (the common path).
guard_run() {
	_where="guard:"
	_guard_hold=0
	if [ -f "$PKG/rgs-version" ] && [ -n "$(cat "$RGS_VERSION_SRC" 2>/dev/null || true)" ]; then
		_rec_rgs="$(sed -n 's/^rgs\.version=//p' "$PKG/rgs-version")"
		_rec_bat="$(sed -n 's/^batocera\.version=//p' "$PKG/rgs-version")"
		_live_rgs="$(cat "$RGS_VERSION_SRC" 2>/dev/null || true)"
		_live_bat="$(cat "$BATOCERA_VERSION_SRC" 2>/dev/null || true)"
		if [ "$_rec_rgs" != "$_live_rgs" ] || [ "$_rec_bat" != "$_live_bat" ]; then
			log "$_where RGS update detected (recorded ${_rec_rgs:-?}/${_rec_bat:-?}, live ${_live_rgs:-?}/${_live_bat:-?}) — re-verifying the layer against the future fix/ state"
			_ok=1
			# (a) Preserve-zone invariants: the update rebuilds batocera.conf
			# keeping everything BEFORE "RGS TUNING" and AFTER "END RGS";
			# inside that zone the PACK decides. Our keys and services list
			# must never live there.
			_tun="$(grep -n 'RGS TUNING' "$GUARD_CONF" 2>/dev/null | head -1 | cut -d: -f1 || true)"
			_end="$(grep -n 'END RGS' "$GUARD_CONF" 2>/dev/null | head -1 | cut -d: -f1 || true)"
			# The LAST occurrence is the effective value (batocera-settings
			# appends); its position decides whether the update rewrites it.
			if [ -n "$_tun" ] && [ -n "$_end" ]; then
				for _key in es.resolution global.videomode global.videooutput2; do
					_line="$(grep -n "^${_key}=" "$GUARD_CONF" | tail -1 | cut -d: -f1 || true)"
					if [ -n "$_line" ] && [ "$_line" -gt "$_tun" ] && [ "$_line" -lt "$_end" ]; then
						log "$_where GUARD FAIL: $_key sits INSIDE the RGS TUNING zone — an update would rewrite it (move after END RGS)"
						_ok=0
					fi
				done
				_sline="$(grep -n '^system\.services=' "$GUARD_CONF" | tail -1 | cut -d: -f1 || true)"
				if [ -n "$_sline" ] && [ "$_sline" -gt "$_tun" ] && [ "$_sline" -lt "$_end" ]; then
					log "$_where GUARD FAIL: system.services INSIDE the RGS TUNING zone — an update would unregister our services (move before RGS TUNING)"
					_ok=0
				fi
			fi
			# (b) Injection check against the FUTURE configgen: shadow tree =
			#    live tree with every fix/-mapped file copied over it (the
			#    map is read from the NEW rgs_config the update shipped) —
			#    then the SAME sitecustomize patch probe verify.sh uses.
			rm -rf "$GUARD_SHADOW"
			if mkdir -p "$GUARD_SHADOW" && cp -a "$GUARD_SITE/configgen" "$GUARD_SHADOW/configgen" 2>/dev/null; then
				grep -E '^[[:space:]]*cp[[:space:]]' "$RGS_CONFIG" 2>/dev/null | while IFS= read -r _cp; do
					_src="$(printf '%s' "$_cp" | awk '{print $2}')"
					_dst="$(printf '%s' "$_cp" | awk '{print $3}')"
					_dst="${_dst%/}" # some cp write a trailing-slash dir dst
					case "$_src" in "$GUARD_FIX"/*.py) ;; *) continue ;; esac
					case "$_dst" in "$GUARD_SITE"/*) ;; *) continue ;; esac
					_tgt="$GUARD_SHADOW/${_dst#"$GUARD_SITE"/}"
					[ -d "$_tgt" ] && _tgt="$_tgt/$(basename "$_src")"
					mkdir -p "$(dirname "$_tgt")"
					[ -f "$_src" ] && cp "$_src" "$_tgt"
				done
				if PYTHONPATH="$GUARD_SHADOW:$GUARD_SITE" python3 - <<'PYEOF' 2>>"$LOG"; then
import sys
import sitecustomize  # noqa: F401  (engine import hook — same probe as verify.sh)
import configgen.emulatorlauncher  # noqa: F401  (pulls utils.videoMode too)
_r = sitecustomize._PATCHER_RESULTS
_bad = [m for m in sitecustomize._PATCHERS if _r.get(m) is not True]
sys.exit(1 if _bad else 0)
PYEOF
					log "$_where patch patterns match the future (fix/) configgen"
				else
					log "$_where GUARD FAIL: patch patterns do NOT match the future (fix/) configgen — layer incompatible with this RGS update"
					_ok=0
				fi
			else
				log "$_where GUARD FAIL: cannot build the fix/ shadow tree (no live configgen?)"
				_ok=0
			fi
			if [ "$_ok" = "1" ]; then
				guard_profile_restore
				printf 'rgs.version=%s\nbatocera.version=%s\n' "$_live_rgs" "$_live_bat" >"$PKG/rgs-version" \
					&& log "$_where layer re-certified on RGS ${_live_rgs} — version adopted (green until the next update)" \
					|| log "$_where WARN: could not write $PKG/rgs-version — verify.sh will keep flagging the mismatch"
			else
				# Hold the layer: do NOT re-inject our files onto the updated
				# system. Stock behavior comes from the engine's fail-safe
				# patches (never break configgen); recovery = uninstall.sh +
				# install.sh from the re-verified package.
				_guard_hold=1
				guard_profile_hold
				log "$_where GUARD HOLD — 15kHz profile disabled (launches run stock/LCD behavior); re-deploy skipped. Open rgs_crt_check in the Batocera config menu to re-verify, or uninstall"
			fi
		else
			# versions match: any profile still held is restored (self-heal
			# after e.g. a manual RGS revert — fix/ is our certified content)
			guard_profile_restore
		fi
	fi
	return "$_guard_hold"
}

# ── amdgpu legacy pin: the dc=0 modprobe file (2026-09-10) ──────────────
# WHY (tester R9 380 black-tube case, evidence chain): on kernels < 6.19
# the amdgpu Display Core (dc=1 — the default for Tonga/Fiji/Polaris/
# Vega) has NO analog encoders: the DVI-I tube gets NO signal while an
# LCD on a digital port lights up (exactly the tester's symptom).
# Upstream landed DC analog encoders in 6.19 (Valve's Timur Kristof,
# Phoronix 2025-10-29); the kernel's own words on < 6.19: "VGA support
# which is not supported with DC" (amdgpu_device.c). dc=0 falls back to
# the classic dce display code (DAC + interlaced complete) = the driver
# class this layer's AMD adapter is calibrated on (dce_v6-class contract,
# GPU-ADAPTERS.md). UNSAFE outside that class: DCN cards (Raven/Navi+)
# have NO legacy display code — dc=0 there = no display at all. The gate
# is the PCI device id of the AMD display device in sysfs, checked
# against the DC-default DCE ranges of the shipped kernel's amdgpu table
# (Tonga/Fiji/Polaris10-12/Vega10/12/20/VEGAM — collision-checked set,
# upstream-proposal classification; no dmesg format dependency, works
# even when amdgpu never printed). Hex string compare is sound: the ids
# are uppercase, same width, ASCII order = numeric order.
# State file (shell-quality §7): who writes = this function (boot duty +
# the install.sh one-shot call), who reads = kmod when amdgpu loads,
# who cleans = uninstall.sh + the remove branch below.
# ── ordering vs rgs_config (2026-10-07) ───────────────────────────────
# rgs_config runs async in the SAME S99 loop (both `start &`) and
# UNCONDITIONALLY re-copies the stock launcher LATE in its script (line
# ~176 of ~270; its early S02resize canary does NOT prove it finished).
# So a re-apply that races it can be clobbered — reproduced 2026-10-07:
# our apply 20:27:30, rgs_config cp 20:27:32 -> verify DIRTY. Wait for the
# rgs_config process to be GONE before re-applying; on a fresh boot it may
# not have started yet, so give it a short grace first. Bounded: a boot
# service must never hang (the belt falls through and logs).
rgs_config_running() {
	local _pat="${RGS15_RGS_CONFIG_PROC:-[/]userdata/system/services/rgs_config}"
	command -v pgrep >/dev/null 2>&1 || return 1
	pgrep -f "$_pat" >/dev/null 2>&1
}

wait_rgs_config_done() {
	# _max/_grace are POLL COUNTS; with the default POLL=1s they are ~seconds.
	local _max="${RGS15_RGS_CONFIG_WAIT:-60}" _grace="${RGS15_RGS_CONFIG_GRACE:-15}"
	local _poll="${RGS15_RGS_CONFIG_POLL:-1}" _i=0 _seen=0
	while [ "$_i" -lt "$_max" ]; do
		if rgs_config_running; then
			_seen=1
		elif [ "$_seen" = "1" ]; then
			log "resolution-patch: rgs_config finished (after ${_i} polls) — ordered re-apply"
			return 0
		elif [ "$_i" -ge "$_grace" ]; then
			log "resolution-patch: rgs_config not seen in ${_grace} polls (already ran or disabled) — re-apply"
			return 0
		fi
		sleep "$_poll"
		_i=$((_i + 1))
	done
	log "resolution-patch: rgs_config still running after ${_max} polls — applying anyway (verify flags any clobber)"
	return 0
}

# ── the stock launcher raster channel (resolution-patch duty, 2026-09-13)
# /usr/bin/batocera-resolution is a STOCK file rgs_config re-copies from
# rgs/fix/ at every boot — so the duty re-applies the raster hunks at every
# boot AFTER rgs_config has finished (wait_rgs_config_done above; the old
# "before this service runs" assumption was false and lost the 2026-10-07
# race). First apply takes a
# whole-file snapshot under backups/stock-originals (restore = uninstall.sh);
# the content guard needs the exact stock anchors: an RGS update that
# changes the file = LOUD skip, verify flags the drift, the next boot
# re-applies when the anchors return. The hunks = the upstream
# batocera-crt-proposal's patch 0003 logic (announce + generate-at-request
# + interlaced fallback), gated on the bridge presence — without the
# engine deployed every hunk's action is byte-for-byte stock. Owner
# authorization 2026-09-13 (direct stock-file modification; when the
# proposal lands upstream this duty + the applier are deleted, the file
# is born already carrying the hunks). The launcher script is read fresh
# at every invocation: no bounce, no reload — a patch between two launches
# is live at the next launch.
resolution_patch_decide() {
	local _tgt="/usr/bin/batocera-resolution" _bak
	[ -n "${RGS15_RES_TARGET:-}" ] && _tgt="$RGS15_RES_TARGET"
	_bak="${RGS15_RES_BAK:-$PKG/backups/stock-originals/batocera-resolution}"
	if python3 "$PKG/src/service/resolution-crt-patch.py" apply "$_tgt" "$_bak" >>"$LOG" 2>&1; then
		log "resolution-patch: launcher raster channel applied (hunks verified)"
		return 0
	fi
	log "resolution-patch: WARN hunks not applied (anchor drift or write refused) — verify flags it, launches run stock-safe"
	return 1
}

# ── GPU dotclock floor — chain property, measured ONCE at the first CRT
#    game launch (owner architecture 2026-09-16) ──────────────────────
# WHY: RA/GroovyMAME run NATIVE (RA super="0", mame.ini dotclock_min 0).
# A chain that cannot produce a native mode's dotclock would go BLACK —
# or worse, ACCEPT the mode and never scan it (Intel PCH: below ~10.4 MHz
# the ICLKIP divider is invalid, xrandr says "active", vblanks never
# arrive, every flip times out — measured 2026-09-20).
# The capability is a property of the CHAIN: measured at BOOT (the S30z
# hook, pre-X, KMS-native via dotclock-measure.py: mode set + WAIT_VBLANK
# = the behavioural oracle), NEVER at game launch (no emulator can be
# disturbed), NEVER hardcoded.
# The floor is written FRESH at every boot into BOTH switchres inis: the
# RA config-dir override AND the system /etc/switchres.ini (owner
# directive 2026-09-20: volatile — the /etc write lives in the RAM
# overlay, recomputed each boot, never overlay-saved by this duty).
# Value precedence (ONE truth source):
#   rgs-15khz.dotclock_min manual knob  >  measured (this boot)  >  0
# `rgs-15khz.dotclock_min=off` disables the floor (both inis floor 0).
# LCD-only boots / no CRT: inert, floor 0 (the stock default).
# The desktop (480i) never consults it: 480i is the boot mode by
# definition and sits above every chain's doubt zone.
dotclock_crt_present() { # CRT-only/dual = active; LCD-only = inert.
	# RGS15_CRT_PRESENT seam (tests: 1/0); else the display layer's own
	# classification. Source order: the sysfs classification FIRST (the
	# display layer's authoritative source; the ONLY one that works pre-X,
	# where the S30z hook runs — without it the boot gate answered "no
	# CRT" and the measured floor was never written, observed 2026-09-20),
	# then the X-time sources (detect_outputs -> CRT_OUTS, detect-state).
	if [ -n "${RGS15_CRT_PRESENT:-}" ]; then
		[ "$RGS15_CRT_PRESENT" = "1" ]
		return
	fi
	local _detect="${RGS15_DETECT:-$PKG/src/display/display-detect.sh}"
	if [ -r "$_detect" ] && bash "$_detect" --list 2>/dev/null | grep -qE '^[^[:space:]]+[[:space:]]+analog[[:space:]]'; then
		return 0
	fi
	[ -n "${CRT_OUTS:-}" ] && return 0
	if ! command -v detect_outputs >/dev/null 2>&1; then
		local _lib
		for _lib in "$PKG/src/lib/gpu-lib.sh" "$PKG/src/lib/display-lib.sh"; do
			# shellcheck disable=SC1090  # dynamic package path
			[ -r "$_lib" ] && source "$_lib" 2>/dev/null
		done
	fi
	command -v detect_outputs >/dev/null 2>&1 && detect_outputs 2>/dev/null
	[ -n "${CRT_OUTS:-}" ] && return 0
	local _crt
	_crt="$(sed -n 's/^CRT_OUT=//p' "${CRT_DUAL_STATE_DIR:-/tmp/crt-dual}/detect-state" 2>/dev/null | head -1)"
	[ -z "$_crt" ] && _crt="${CRT_OUT:-${CRT_PRESUMED_OUT:-}}"
	[ -n "$_crt" ]
}
dotclock_ini_write() {
	# $1 = ini path, $2 = normalized value. Idempotent: rewrite only on
	# drift; append when the key is absent. Atomic (tmp+mv). The stock
	# system ini ships CRLF — the line's own ending is PRESERVED on
	# rewrite (the RA override is born from that file).
	local _ini="$1" _val="$2" _raw _line _eol _want _want_raw _tmp
	[ -f "$_ini" ] || return 1
	_raw="$(grep -E '^[[:space:]]*dotclock_min[[:space:]]' "$_ini" | head -1 || true)"
	_line="$_raw" _eol=""
	case "$_line" in
	*$'\r') _eol=$'\r'; _line="${_line%$'\r'}" ;;
	esac
	if [ -n "$_line" ]; then
		# keep the file's own key column (its whitespace) + ending
		_want="$(printf '%s' "$_line" | sed -E 's/^([[:space:]]*dotclock_min[[:space:]]+).*/\1'"$_val"'/')"
		_want_raw="$_want$_eol"
		[ "$_raw" = "$_want_raw" ] && return 0
	else
		_want_raw="$(printf 'dotclock_min              %s\n' "$_val")"
	fi
	_tmp="${_ini}.tmp.$$"
	if [ -n "$_raw" ]; then
		awk -v line="$_raw" -v want="$_want_raw" '
			{ if ($0 == line && !done) { print want; done = 1 } else print }' \
			"$_ini" >"$_tmp" || return 1
	else
		cat "$_ini" "$_want_raw" 2>/dev/null >"$_tmp" || return 1
	fi
	mv "$_tmp" "$_ini" || return 1
	return 0
}

dotclock_normalize() {
	# $1 = raw value -> 0 (for zero) or one-decimal float; empty on invalid
	awk -v v="$1" 'BEGIN { if (v !~ /^[0-9]+([.][0-9]+)?$/) exit 1
		f = v + 0; if (f == 0) print "0"; else printf "%.1f", f }'
}

dotclock_ra_ini="${RGS15_RA_SWITCHRES:-/userdata/system/configs/retroarch/switchres.ini}"
dotclock_sys_ini="${RGS15_SYS_SWITCHRES:-/etc/switchres.ini}" # written at boot (volatile)

dotclock_ra_write() { # $1 = value: write the floor into the RA override
	# — the file RA 1.22 reads. Born from the (freshly floored) system
	# ini on first write; RA ini absent in stock.
	[ -f "$dotclock_ra_ini" ] || {
		mkdir -p "$(dirname "$dotclock_ra_ini")" 2>/dev/null || true
		{
			printf '# Managed by crt-dual (dotclock floor, measured at boot; base: %s)\n' "$dotclock_sys_ini"
			cat "$dotclock_sys_ini" 2>/dev/null
		} >"$dotclock_ra_ini" 2>/dev/null || return 1
	}
	dotclock_ini_write "$dotclock_ra_ini" "$1"
}

dotclock_write() { # $1 = measured floor in MHz (empty = measurement failed)
	# The single writer of the dotclock floor (knob > measured > 0).
	# Writes BOTH switchres inis fresh every boot: the system
	# /etc/switchres.ini (volatile: the write lives in the RAM overlay,
	# recomputed each boot, never overlay-saved by this duty) and the RA
	# config-dir override born from it. Idempotent (rewrite only on drift).
	local _measured="$1" _val="" _src="" _knob
	if ! dotclock_crt_present; then
		_val="0" _src="no CRT (inert)"
	else
		_knob="$(conf_get 'rgs-15khz\.dotclock_min')"
		if [ "$_knob" = "off" ]; then
			_val="0" _src="manual off (knob)"
		elif [ -n "$_knob" ] && [ -n "$(dotclock_normalize "$_knob")" ]; then
			_val="$(dotclock_normalize "$_knob")" _src="manual (rgs-15khz.dotclock_min=$_knob)"
		elif [ -n "$_measured" ] && [ -n "$(dotclock_normalize "$_measured")" ]; then
			_val="$(dotclock_normalize "$_measured")" _src="measured this boot (${_measured} MHz)"
		else
			_val="0" _src="no measurement (stock default)"
		fi
	fi
	if dotclock_ini_write "$dotclock_sys_ini" "$_val"; then
		log "dotclock-write: $dotclock_sys_ini dotclock_min=$_val ($_src)"
	else
		log "dotclock-write: WARN could not write $dotclock_sys_ini"
	fi
	if dotclock_ra_write "$_val"; then
		log "dotclock-write: $dotclock_ra_ini dotclock_min=$_val ($_src)"
	else
		log "dotclock-write: WARN could not write $dotclock_ra_ini"
	fi
	return 0
}

amdgpu_legacy_decide() {
	local _kernel="${RGS15_UNAME_R:-$(uname -r 2>/dev/null || true)}"
	local _knob _pci _d _id _hit=0
	_knob="$(conf_get 'rgs-15khz\.amdgpu-legacy')"
	if [ -n "${RGS15_PCI_SYS:-}" ]; then _pci="$RGS15_PCI_SYS"; else _pci="/sys/bus/pci/devices"; fi
	for _d in "$_pci"/*; do
		[ -r "$_d/vendor" ] || continue
		[ "$(cat "$_d/vendor" 2>/dev/null)" = "0x1002" ] || continue
		case "$(cat "$_d/class" 2>/dev/null)" in
		0x0300* | 0x0380*) ;;
		*) continue ;;
		esac
		_id="$(cat "$_d/device" 2>/dev/null | tr 'a-f' 'A-F')"
		_id="${_id#0X}"; _id="${_id#0x}"
		if printf '%s\n' "$_id" | awk -v R="66A0-66AF 67C0-67FF 6860-687F 6920-6939 694C-694F 6980-699F 69A0-69AF 7300-730F" '
			BEGIN { n = split(R, r, " "); ok = 0 }
			{ for (i = 1; i <= n; i++) { split(r[i], p, "-")
				if ($0 >= p[1] && $0 <= p[2]) ok = 1 }
			  if ($0 == "6FDF") ok = 1; exit !ok }'; then
			_hit=1
			break
		fi
	done
	local _want=0
	if [ "$_knob" = "off" ]; then
		_want=0
	elif [ "$_kernel" != "$(printf '%s\n' '6.19' "$_kernel" | sort -V | tail -1)" ]; then
		# strictly below 6.19 (sort -V: the larger of {6.19, kernel} != kernel)
		[ "$_hit" = "1" ] && _want=1
	fi
	if [ "$_want" = "1" ]; then
		if [ -f "$MODPROBE_CONF" ] && grep -q "^options amdgpu dc=0$" "$MODPROBE_CONF"; then
			log "amdgpu-legacy: pin converged (kernel=$_kernel id=${_id:-none})"
		else
			local _tmp="$MODPROBE_CONF.tmp.$$"
			{
				echo "# rgs-15khz: pin the amdgpu classic display stack (dc=0) — kernel"
				echo "# $_kernel, AMD id 0x${_id:-?} (DC-default DCE) has no analog encoders"
				echo "# in Display Core before 6.19. Written by zz_rgs_15khz (amdgpu-legacy)"
				echo "# for the next module load; removed by uninstall.sh, when the kernel"
				echo "# reaches 6.19+ or when rgs-15khz.amdgpu-legacy=off is set in batocera.conf."
				echo "options amdgpu dc=0"
			} >"$_tmp" && mv "$_tmp" "$MODPROBE_CONF" \
				&& log "amdgpu-legacy: pin WRITTEN ($MODPROBE_CONF) — applies at the NEXT amdgpu load" \
				|| log "amdgpu-legacy: WARN: could not write $MODPROBE_CONF"
		fi
	else
		if [ -e "$MODPROBE_CONF" ]; then
			rm -f "$MODPROBE_CONF"
			log "amdgpu-legacy: pin removed (not applicable: kernel=$_kernel id=${_id:-none} knob=${_knob:-auto})"
		fi
	fi
	return 0
}

# ── Intel i915 480i patch: /boot hook + module (2026-09-10) ────────────
# WHY (tester Intel HD 530 black-tube report, 2026-09-10, evidence chain
# in the tester bundle): stock gen9 i915 rejects Y-tiled scanout in
# IF-ID interlace mode while Mesa/glamor allocates Y-tiled buffers —
# every 480i modeset dies -EINVAL; X came up "no screens found" and the
# engine never converged. The community patch set amxcs/
# batocera-crt-15khz-intel fixes exactly this (patched driver advertises
# only LINEAR/X_TILED on gen9); its prebuilt module targets THIS
# Batocera/kernel line, vermagic-checked before use. THE MODULE IS THE
# ONLY PIECE taken from that project — their installer also rewrites ES
# modes / batocera.conf keys / boot cmdline, which would fight this
# layer; see THIRD-PARTY.md.
# /lib/modules lives on the RAM overlay (reverts at boot) and i915 cannot
# be unloaded live, so the module is swapped by the /boot hook at every
# boot BEFORE udev (stock S00bootcustom runs /boot/boot-custom.sh) — the
# hook (src/service/i915/boot-custom.sh) re-checks vermagic itself, so a
# kernel update keeps stock i915 loading instead of a black tube.
# Gate = the KERNEL's own boot line ("Initialized i915" — the i915 iGPU
# bound this boot), never a PCI list and never a hardcoded box.
# State files (shell-quality §7): /boot/boot-custom.sh (writer = this
# duty + install.sh, reader = stock S00bootcustom; foreign hook never
# overwritten) and /boot/i915-patched.ko (writer = this duty + install.sh,
# reader = the /boot hook; removed by uninstall.sh and by this duty on
# non-Intel boots — /boot is a ro vfat, the removal remounts rw and
# restores ro). The hook's provenance gate is its own marker line, never a
# byte-compare against the repo copy: a repo edit made OUR older hook read
# as foreign and the non-Intel cleanup left it behind (AMD boot
# 2026-09-21). The fetched module is archived in the repo's binaries dir
# (user-procured class, gitignored) so a later boot redeploys it without
# re-downloading.
_i915_hook_is_ours() { # $1 = hook path — marker line present in every shipped version
	local _h="$1"
	[ -f "$_h" ] || return 1
	grep -q 'patched i915 swap for Intel 480i' "$_h" 2>/dev/null
}

i915_patch_decide() {
	local _kernel _dmesg_ok _repo _hook_src _hook_dst _mod_dst _mod_name
	local _hook_ok _mod_src _vm _want_fetch _dmesg_txt
	local _rm_list _left_list _remount _p
	_kernel="${RGS15_UNAME_R:-$(uname -r 2>/dev/null || true)}"
	_hook_dst="${RGS15_BOOT_HOOK:-/boot/boot-custom.sh}"
	_mod_dst="${RGS15_BOOT_MOD:-/boot/i915-patched.ko}"
	# repo root: install.sh passes it (fresh install order); the boot duty
	# derives it from the recorded install-source (the project folder).
	if [ -n "${RGS15_I915_REPO:-}" ]; then
		_repo="$RGS15_I915_REPO"
	else
		_repo="$(cat "$PKG/install-source" 2>/dev/null || true)"
	fi
	_hook_src="$_repo/src/service/i915/boot-custom.sh"
	# Read the boot log ONCE and match with case — never `dmesg | grep -q`
	# under pipefail: grep -q exits at the first match, a >64 KiB dmesg
	# dies on SIGPIPE, the pipeline reports 141 and the &&/|| idiom reads
	# "no i915 this boot" on an Intel box (tester HD 530 bundle,
	# 2026-09-12: the module was removed and never re-deployed -> black
	# tube; seam test_intel_i915_patch case 9).
	if [ -n "${RGS15_DMESG_SRC:-}" ]; then
		_dmesg_txt="$(cat "$RGS15_DMESG_SRC" 2>/dev/null || true)"
	else
		_dmesg_txt="$(dmesg 2>/dev/null || true)"
	fi
	case "$_dmesg_txt" in
	*"Initialized i915"*) _dmesg_ok=1 ;;
	*) _dmesg_ok=0 ;;
	esac
	if [ "$_dmesg_ok" = "0" ]; then
		# not an Intel-iGPU boot: OUR pieces must NOT linger — a leftover
		# hook runs a stale module check forever and verify.sh flags
		# either file. A foreign hook is NEVER touched (loud log;
		# uninstall refuses it too). /boot is a ro vfat on this line
		# (mount shows ro,errors=remount-ro): a direct rm works only
		# when it is somehow writable, otherwise remount rw -> retry ->
		# restore ro (the sequence uninstall.sh §3b uses). AMD boot
		# 2026-09-21 after the Intel phase: the old code removed only
		# the module with a silent rm on the ro /boot — both files
		# stayed and verify.sh went DIRTY.
		_rm_list=""
		_left_list=""
		[ -e "$_mod_dst" ] && _rm_list="$_rm_list $_mod_dst"
		if [ -e "$_hook_dst" ]; then
			if _i915_hook_is_ours "$_hook_dst"; then
				_rm_list="$_rm_list $_hook_dst"
			else
				log "i915-patch: WARN: boot hook is FOREIGN (no crt-dual marker) on a non-Intel box — left in place (inspect $LOG)"
				_left_list="$_left_list $_hook_dst"
			fi
		fi
		_remount=0
		for _p in $_rm_list; do
			rm -f "$_p" 2>/dev/null && continue
			if [ "$_remount" = "0" ]; then
				mount -o remount,rw /boot 2>/dev/null || true # a failed remount cannot hide: the retry below still fails and the path is logged loud
				_remount=1
			fi
			rm -f "$_p" 2>/dev/null || _left_list="$_left_list $_p"
		done
		if [ "$_remount" = "1" ]; then
			sync
			mount -o remount,ro /boot 2>/dev/null || true # canonical restore (uninstall.sh does the same); nothing here needs /boot writable
		fi
		if [ -z "$_left_list" ]; then
			# log fidelity: nothing present = silent no-op, never a
			# phantom "removed" line (case 14 pins it)
			[ -n "$_rm_list" ] && log "i915-patch: ours removed (not applicable: no i915 this boot)"
			return 0
		fi
		log "i915-patch: WARN: /boot cleanup incomplete (left:$_left_list — verify.sh will flag)"
		return 1
	fi
	# Intel: converge hook + module onto /boot. Never overwrite a foreign
	# hook (provenance = the crt-dual marker line; OUR older hook converges,
	# the repo copy replaces it); never deploy a module whose vermagic is
	# not the running kernel.
	if [ -e "$_hook_dst" ] && ! _i915_hook_is_ours "$_hook_dst"; then
		log "i915-patch: GUARD FAIL: boot hook is FOREIGN (no crt-dual marker) — refusing to touch it (amxcs installer or other CRT tool? uninstall theirs first)"
		return 1
	fi
	_mod_name="i915-patched-$_kernel.ko"
	_mod_src=""
	if [ -f "$_mod_dst" ]; then
		_mod_src="$_mod_dst"
	elif [ -f "$_repo/src/service/i915/binaries/$_mod_name" ]; then
		_mod_src="$_repo/src/service/i915/binaries/$_mod_name"
	elif [ "${RGS15_I915_ALLOW_FETCH:-}" = "1" ]; then
		_want_fetch="https://github.com/amxcs/batocera-crt-15khz-intel/releases/download/batocera-$(cut -d' ' -f1 "$BATOCERA_VERSION_SRC" 2>/dev/null)/$_mod_name"
		mkdir -p "$_repo/src/service/i915/binaries" 2>/dev/null || true
		if curl -fsSL "$_want_fetch" -o "$_repo/src/service/i915/binaries/$_mod_name" 2>/dev/null; then
			_mod_src="$_repo/src/service/i915/binaries/$_mod_name"
			log "i915-patch: module fetched from the amxcs release (public URL, no credentials) -> $_repo/src/service/i915/binaries/$_mod_name"
		else
			log "i915-patch: no prebuilt module fetched (release 404 or offline) — build per the amxcs README and place i915-patched-$_kernel.ko in src/service/i915/binaries/, then reinstall; progressive 15kHz still works, 480i does not"
		fi
	else
		log "i915-patch: module absent and fetch not allowed (boot recompute) — place i915-patched-$_kernel.ko in src/service/i915/binaries/ and reinstall"
	fi
	if [ -z "$_mod_src" ]; then
		# nothing deployed at all: a hook without its module is dead weight,
		# and the NEXT boot after the module is placed (repo binaries or
		# fetch) deploys the pair in one pass
		return 0
	fi
	_vm="$(modinfo -F vermagic "$_mod_src" 2>/dev/null || true)"
	case "$_vm" in
	"$_kernel"*) ;;
	"")
		log "i915-patch: GUARD FAIL: vermagic unreadable on $_mod_src — not a module built for kernel $_kernel; refusing to deploy it (no-display risk)"
		return 1
		;;
	*)
		log "i915-patch: GUARD FAIL: vermagic mismatch (module '$_vm' vs kernel '$_kernel') — refusing to deploy it; stock i915 stays (recoverable, not a black tube)"
		return 1
		;;
	esac
	# Converged check first: identical hook + identical module = zero writes
	# (no /boot remount on the common path).
	_hook_ok=0
	[ -e "$_hook_dst" ] && cmp -s "$_hook_dst" "$_hook_src" && _hook_ok=1
	if [ "$_hook_ok" = "1" ] && [ -f "$_mod_dst" ] && cmp -s "$_mod_src" "$_mod_dst"; then
		log "i915-patch: converged (hook identical, module vermagic $_vm)"
		return 0
	fi
	if ! (
		mount -o remount,rw /boot 2>/dev/null || exit 9
		trap 'sync; mount -o remount,ro /boot 2>/dev/null' EXIT
		cp "$_hook_src" "$_hook_dst" 2>/dev/null || exit 10
		chmod +x "$_hook_dst" 2>/dev/null || true
		cp "$_mod_src" "$_mod_dst" 2>/dev/null || exit 10
		sync
	) 2>/dev/null; then
		log "i915-patch: WARN: /boot deploy failed (remount/copy) — verify.sh will flag"
		return 0
	fi
	log "i915-patch: deployed hook ($_hook_dst) + module ($_mod_dst, vermagic $_vm) — the hook swaps it BEFORE udev at every boot"
	return 0
}

# ── update feed (feed client): feed-check + tool-update ────────────────
# feed-check prints exactly ONE line for the UI (first word parsed):
# CURRENT <installed> | UPDATE <feedver> | BLOCKED <feedver> <targetrgs>
# | OFFLINE. Non-destructive, best-effort: any fetch failure, unreadable
# or malformed version = OFFLINE (never blocks, never touches live
# state). Versions are MAJOR.MINOR.REV; the target base is the first two
# components (the RGS line the release is certified on); comparison is the
# FULL numeric tuple (a REV-only compare would call 43.54.9 newer than
# 43.55.1). The fetch always carries --max-time via RGS15_FETCH_BIN
# (default curl, same shape as get.sh); RGS15_FEED_ALLOW_NET=1 opts into
# the network — unset/0 answers OFFLINE without fetching (hermetic seams,
# offline-safe default). Installed is read from ${PKG}.version, live RGS
# from RGS_VERSION_SRC. tool-update runs get.sh — the ONE install/update
# chain — from the recorded project folder, then reboots (deliberate,
# user-launched from rgs_crt_check, same shape as tool-uninstall).
feed_is_rev() { # $1 -> rc 0 iff MAJOR.MINOR.REV, all numeric
	case "${1:-}" in
	"" | *[^0-9.]*) return 1 ;;
	esac
	# grep without -q drains to EOF (no SIGPIPE trap — shell-quality);
	# the || true guards the redirect under set -o pipefail.
	[ "$(printf '%s' "$1" | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' || true)" = "$1" ]
}

feed_is_base() { # $1 -> rc 0 iff it starts with numeric MAJOR.MINOR (live rgs.version shape)
	case "${1:-}" in
	"" | *[^0-9.]*) return 1 ;;
	esac
	[ -n "$(printf '%s' "$1" | grep -E '^[0-9]+\.[0-9]+' || true)" ]
}

feed_vercmp() { # $1 $2 = MAJOR.MINOR.REV -> prints -1 / 0 / 1 (full tuple, numeric)
	awk -v a="$1" -v b="$2" 'BEGIN {
		split(a, A, "."); split(b, B, ".");
		for (i = 1; i <= 3; i++) {
			x = A[i] + 0; y = B[i] + 0;
			if (x < y) { print -1; exit }
			if (x > y) { print 1; exit }
		}
		print 0
	}'
}

feed_base_ge() { # $1 = live RGS, $2 = target base -> rc 0 iff live >= target (first two components, numeric)
	awk -v a="$1" -v b="$2" 'BEGIN {
		split(a, A, "."); split(b, B, ".");
		for (i = 1; i <= 2; i++) {
			x = A[i] + 0; y = B[i] + 0;
			if (x < y) exit 1;
			if (x > y) exit 0
		}
		exit 0
	}'
}

do_start() {
	# 1. Truncate our logs (boot-pristine).
	for _f in $TRUNCATE_LIST; do
		: >"$LOGS_DIR/$_f" 2>/dev/null || true
	done
	log "start: logs truncated ($TRUNCATE_LIST)"

	# 2. Early canary only: has rgs_config STARTED? S02resize is copied near
	#    the TOP of its script, so a match says NOTHING about whether it
	#    FINISHED — the late launcher cp is handled by wait_rgs_config_done
	#    at 3d (the 2026-10-07 boot logged "ordering OK" here and was then
	#    clobbered). Kept as a cheap progress signal, never as ordering proof.
	if [ -f "$RGS_FIX/S02resize-v42fix" ] && [ -f "/etc/init.d/S02resize" ] \
		&& cmp -s "$RGS_FIX/S02resize-v42fix" "/etc/init.d/S02resize"; then
		log "start: rgs_config early canary in place (S02resize copied; finishing not implied)"
	else
		log "start: rgs_config early canary absent (not started yet, or fix changed)"
	fi

	# 3. Update watch (boot): adopt a re-verified update or hold.
	_guard_hold=0
	guard_run || _guard_hold=1

	# 3b. amdgpu-legacy pin (modprobe dc=0 file; the NEXT boot reads it
	#     before the module binds). Guard-hold skips it: system pins are
	#     not recomputed on an unverified system — same discipline as the
	#     re-deploy skip below.
	_mod_changed=0
	if [ "$_guard_hold" = "1" ]; then
		log "start: amdgpu-legacy pin skipped (guard hold)"
	else
		_before=0
		[ -f "$MODPROBE_CONF" ] && _before=1
		amdgpu_legacy_decide
		_after=0
		[ -f "$MODPROBE_CONF" ] && _after=1
		[ "$_before" != "$_after" ] && _mod_changed=1
	fi
	if [ "$_mod_changed" = "1" ]; then
		if command -v batocera-save-overlay >/dev/null 2>&1 \
			&& batocera-save-overlay >/dev/null 2>&1; then
			log "start: overlay saved after amdgpu-legacy pin change"
		else
			log "start: overlay save FAILED after amdgpu-legacy pin change (verify.sh will flag)"
		fi
	fi

	# 3c. i915 patch (/boot hook + module; self-healing, boot-safe).
	#     Guard-hold skips it: system-level state is not recomputed on an
	#     unverified system — same discipline as 3b and the re-deploy skip.
	if [ "$_guard_hold" = "1" ]; then
		log "start: i915 patch skipped (guard hold)"
	else
		i915_patch_decide
	fi

	# 3d. launcher raster hunks (/usr/bin/batocera-resolution; rgs_config
	#     re-copies the stock file LATE in its script — wait until it has
	#     finished, THEN re-apply, or the copy clobbers us; self-healing
	#     every boot, snapshot at first apply). Guard-hold skips it like 3c:
	#     system-level state is not recomputed while held.
	if [ "$_guard_hold" = "1" ]; then
		log "start: resolution patch skipped (guard hold)"
	else
		wait_rgs_config_done
		resolution_patch_decide
	fi

	# 3d-bis. dotclock floor: the S30z boot hook wrote BOTH switchres
	#     inis pre-X (measured, fresh every boot). Nothing to recompute
	#     here: X is up at S99, the measurement cannot take the DRM
	#     master, and re-writing without a measurement would zero the
	#     floor the boot hook just measured. Guard-hold skips the whole
	#     duty anyway (system-level state is not recomputed while held).
	if [ "$_guard_hold" = "1" ]; then
		log "start: dotclock duty skipped (guard hold — S30z wrote it pre-X)"
	fi

	# 3d-ter. dotclock floor: the boot measurement lives in the S30z hook
	#     (pre-X, KMS-native, both inis written fresh every boot). This
	#     S99 duty does NOT touch it: X is up here, the measurement cannot
	#     take the DRM master, and re-writing without a measurement would
	#     zero the floor the boot hook just measured.

	# 4. Re-deploy manifest overlay files (cmp||cp; save IFF drifted).
	if [ "$_guard_hold" = "1" ]; then
		log "start: re-deploy skipped (guard hold)"
	elif [ ! -f "$MANIFEST" ]; then
		log "start: no overlay manifest (pre-integration install?) — nothing to re-deploy"
	elif [ ! -d "$PKG/src" ]; then
		log "start: package missing with manifest present — run install.sh (refusing to guess)"
	else
		_drift=0
		while IFS= read -r _dst || [ -n "$_dst" ]; do
			[ -n "$_dst" ] || continue
			case "$_dst" in \#*) continue ;; esac
			_src="$(manifest_src "$_dst")" || {
				log "start: UNMAPPED manifest entry $_dst — run install.sh"
				continue
			}
			if [ -f "$_dst" ] && cmp -s "$_src" "$_dst"; then
				continue
			fi
			if cp "$_src" "$_dst" 2>/dev/null; then
				log "start: re-deployed $_dst (was missing/drifted)"
				_drift=1
			else
				log "start: FAILED to re-deploy $_dst"
			fi
		done <"$MANIFEST"
		if [ "$_drift" = "1" ]; then
			if command -v batocera-save-overlay >/dev/null 2>&1 \
				&& batocera-save-overlay >/dev/null 2>&1; then
				log "start: overlay saved after re-deploy"
			else
				log "start: overlay save FAILED after re-deploy (verify.sh will flag)"
			fi
		else
			log "start: overlay files converged (no re-deploy)"
		fi
	fi

	# 5. VNC symlinks (stateless per boot: recreate always, no save needed —
	#    next boot recreates them again; a reboot never strands them).
	if [ "$_guard_hold" = "1" ]; then
		log "start: VNC symlinks skipped (guard hold)"
	elif [ -d "$PKG/src/vnc" ]; then
		ln -sf "$PKG/src/vnc/vnc" /usr/bin/vnc 2>/dev/null || true
		ln -sf "$PKG/src/vnc/vnc-scaled" /usr/bin/vnc-scaled 2>/dev/null || true
		log "start: VNC symlinks re-created"
	fi

	log "start: done"
	return 0
}

case "${1:-}" in
start)
	do_start
	exit 0
	;;
stop)
	exit 0
	;;
tool-uninstall)
	# DELIBERATE teardown from the rgs_crt_check tool (user-launched, no
	# game launch in flight): run the recorded installer's uninstall.sh,
	# then reboot into pure stock RGS.
	_src="$(cat "$PKG/install-source" 2>/dev/null || true)"
	if [ -n "$_src" ] && [ -f "$_src/uninstall.sh" ]; then
		log "tool: uninstall requested (deliberate, from rgs_crt_check) — running $_src/uninstall.sh then reboot"
		if bash "$_src/uninstall.sh" >>"$LOG" 2>&1; then
			log "tool: uninstall complete — rebooting into stock RGS"
			reboot
		else
			log "tool: uninstall returned non-zero — reboot ABORTED (inspect the log)"
		fi
	else
		log "tool: uninstall requested but no install-source recorded ($PKG/install-source) — run uninstall.sh from the project folder"
	fi
	exit 0
	;;
gamelist-ensure)
	# Our entry in the +rgs gamelist. ES rewrites gamelists when it records
	# a launch and drops entries applied while it was running (observed
	# 2026-09-07: boot re-assert keeps ours alive). Idempotent, OURS only:
	# first-run backup ($PKG/backups/rgs-gamelist.xml, restored by
	# uninstall.sh), insert guarded by grep, tile image generated once.
	_gl="$RGS_DIR/gamelist.xml"
	[ -f "$_gl" ] || exit 0 # no rgs rom dir: nothing to do
	mkdir -p "$PKG/backups" 2>/dev/null || true
	[ -f "$PKG/backups/rgs-gamelist.xml" ] || cp "$_gl" "$PKG/backups/rgs-gamelist.xml"
	if ! grep -q 'rgs_crt_check.sh' "$_gl"; then
		python3 - "$_gl" <<'PYEOF'
