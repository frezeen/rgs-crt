"""
if "rgs_crt_check.sh" not in text:
    text = text.replace("</gameList>", block + "</gameList>", 1)
    open(gl, "w", encoding="utf-8").write(text)
PYEOF
		log "start: gamelist entry re-asserted (ES had dropped or it was missing)"
	fi
	_img="$RGS_DIR/media/images/rgs_crt_check.png"
	if [ ! -f "$_img" ]; then
		SDL_VIDEODRIVER=dummy python3 - "$_img" <<'PYEOF' 2>/dev/null || true
