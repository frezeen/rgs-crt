amdgpu-legacy)
	# One-shot recompute of the amdgpu dc=0 modprobe pin (install.sh calls
	# it at install so the FIRST boot after install already pins; the boot
	# duty recomputes every boot). Log-only errors: never blocks a boot.
	amdgpu_legacy_decide
	exit 0
	;;
i915-patch)
	# One-shot deploy of the Intel i915 480i patch onto /boot (install.sh
	# calls it with RGS15_I915_REPO + RGS15_I915_ALLOW_FETCH=1; the boot
	# duty recomputes every boot). rc 1 = a foreign hook or a refused
	# module (install.sh echoes the WARN and continues — the state stays
	# loud in verify.sh); log-only inside the function otherwise.
	i915_patch_decide
	exit $?
	;;
resolution-patch)
	# One-shot apply of the launcher raster hunks (install.sh 7c + the boot
	# duty). rc 1 = anchor drift (the applier logged it loudly; install.sh
	# reports the WARN and continues; the boot duty ignores rc).
	resolution_patch_decide
	exit $?
	;;
dotclock-write)
	# Boot entry (the S30z hook, pre-X): write the floor measured by
	# dotclock-measure.py into BOTH switchres inis, fresh every boot.
	# $2 = the measured MHz (empty = the measurement failed -> floor 0,
	# loud in the log). Knob precedence lives in dotclock_write.
	dotclock_write "${2:-}"
	exit 0
	;;
tool-check)
	# the rgs_crt_check pygame tool: verdict line for the UI (first word),
	# same watch logic; PASS restores held profiles + adopts
	guard_run
	if [ "$_guard_hold" = "0" ]; then
		echo "GREEN"
		log "tool: verdict GREEN (layer certified)"
	else
		echo "RED"
		log "tool: verdict RED (layer not certifiable on this system)"
	fi
	exit 0
	;;
feed-check)
	# the update feed probe for rgs_crt_check (UI parses the first
	# word; empty/garbage => OFFLINE on the UI side). Exactly ONE line
	# on stdout, always; exit 0 always (a probe never fails the caller).
	_installed="$(tr -d ' \t\r\n' <"${PKG}.version" 2>/dev/null || true)"
	_live_rgs="$(tr -d ' \t\r\n' <"$RGS_VERSION_SRC" 2>/dev/null || true)"
	_feed_url="${RGS15_FEED_VERSION_URL:-https://raw.githubusercontent.com/frezeen/rgs-crt/main/VERSION}"
	_fetch="${RGS15_FETCH_BIN:-curl}"
	_timeout="${RGS15_FETCH_TIMEOUT:-8}"
	_line="OFFLINE"
	if [ "${RGS15_FEED_ALLOW_NET:-0}" = "1" ]; then
		_tmp="$(mktemp /tmp/rgs-crt-feed.XXXXXX 2>/dev/null || true)"
		# -L follows redirects (release-asset hosts answer 302; without
		# it curl banks an empty body with rc 0 and the probe misreads).
		if [ -n "$_tmp" ] && "$_fetch" -fsSL --max-time "$_timeout" -o "$_tmp" "$_feed_url" 2>/dev/null; then
			_feed="$(tr -d ' \t\r\n' <"$_tmp" 2>/dev/null || true)"
			if feed_is_rev "$_feed" && feed_is_rev "$_installed"; then
				_cmp="$(feed_vercmp "$_feed" "$_installed")"
				if [ "$_cmp" = "0" ] || [ "$_cmp" = "-1" ]; then
					_line="CURRENT $_installed"
				else
					_target="$(printf '%s' "$_feed" | cut -d. -f1,2)"
					if feed_is_base "$_live_rgs" && feed_base_ge "$_live_rgs" "$_target"; then
						_line="UPDATE $_feed"
					else
						_line="BLOCKED $_feed $_target"
					fi
				fi
			fi
		fi
		rm -f "$_tmp" 2>/dev/null || true # benign: the probe must leave no temp file behind
	fi
	echo "$_line"
	log "tool: feed-check $_line"
	exit 0
	;;
tool-update)
	# DELIBERATE update from the rgs_crt_check tool (user-launched, no
	# game launch in flight): run get.sh — the ONE install/update chain —
	# from the recorded project folder, then reboot into the updated
	# layer. Missing source/get.sh = loud log + non-zero exit, NO reboot
	# (fail-safe: never reboot a box that could not be updated); a
	# failing get.sh likewise aborts the reboot.
	_src="${RGS15_SRC:-$(cat "$PKG/install-source" 2>/dev/null || true)}"
	_get="${RGS15_UPDATE_GET:-$_src/get.sh}"
	if [ -z "$_src" ] || [ ! -f "$_get" ]; then
		log "tool: update requested but no usable get.sh (src='${_src:-?}' get='${_get:-?}') — run get.sh from the project folder by hand"
		exit 1
	fi
	log "tool: update requested (deliberate, from rgs_crt_check) — running $_get then reboot"
	if bash "$_get" >>"$LOG" 2>&1; then
		log "tool: update complete — rebooting into the updated layer"
		reboot
		exit 0
	else
		_rc=$?
		log "tool: update returned non-zero (rc=$_rc) — reboot ABORTED (inspect the log)"
		exit "$_rc"
	fi
	;;*)
	echo "usage: $0 {start|stop|tool-check|feed-check|tool-update|tool-uninstall|gamelist-ensure|amdgpu-legacy|i915-patch|resolution-patch|dotclock-write}" >&2
	exit 1
	;;
esac
